{
  "name": "make-it-accessible",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"packages/*/src/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "stage0": "node packages/eval/src/run.ts",
    "adhoc": "node packages/eval/src/adhoc.ts",
    "aggregate": "node packages/eval/src/aggregate.ts",
    "keys:check": "node packages/eval/src/keys-check.ts",
    "select-pages": "node packages/eval/src/select-pages.ts",
    "ledger": "node packages/eval/src/ledger-cli.ts",
    "keys:stage": "node packages/eval/src/stage.ts",
    "keys:write": "node packages/eval/src/write-key.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
